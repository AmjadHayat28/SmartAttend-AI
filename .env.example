# Copy to .env and adjust:   Copy-Item .env.example .env
# A production server can keep its settings OUTSIDE the repository instead: set the environment
# variable SMARTCLASS_ENV_FILE to that file (deploy/windows/setup_tasks.ps1 does this).
# NEVER commit .env — it is git-ignored.
#
# PRODUCTION: set ENVIRONMENT=production. The server then REFUSES TO START unless:
#   - JWT_SECRET_KEY is a random value of 32+ characters (not the placeholder below)
#   - DEBUG=false
#   - DATABASE_URL points at PostgreSQL and is not the development default below
#   - CORS_ORIGINS lists your real frontend origin(s) (https://..., no localhost, never "*")
#   - APP_TIMEZONE is set (e.g. Asia/Karachi)
# and init_db refuses to create the first super admin with the default SUPERADMIN_PASSWORD.
# Startup errors name the problem settings but never print their values.

# --- Application ---
ENVIRONMENT=development
DEBUG=false

# --- PostgreSQL ---
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:PORT/DATABASE
# (URL-encode special characters in the password, e.g. @ → %40). Local development may use
# sqlite:///./smartclass.db instead; production must use PostgreSQL.
DATABASE_URL=postgresql+psycopg2://smartclass:smartclass@localhost:5432/smartclass_db
DB_ECHO=false
# PostgreSQL connection pool, per worker process (max connections = POOL_SIZE + MAX_OVERFLOW).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
# Seconds before a database that is down counts as unavailable (API answers 503).
DB_CONNECT_TIMEOUT=5

# --- JWT ---
# Generate a strong secret:  uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
BCRYPT_ROUNDS=12
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# The refresh token is only ever an HttpOnly cookie (never in JSON or browser storage).
# AUTH_COOKIE_SECURE: unset = Secure in production (HTTPS) only. Never set it to false in production.
#AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=strict

# --- Login rate limiting ---
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# database = counts shared by all workers and kept across restarts (production default);
# memory = per process, only correct with ONE worker (development default). Empty = default.
#LOGIN_RATE_LIMIT_BACKEND=database

# --- CORS (comma-separated, or a JSON list) ---
# Exact origins only. Production example: CORS_ORIGINS=https://attendance.your-university.edu
# With the recommended same-origin setup (frontend and /api on one site), list that site's address.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_TYPES=image/jpeg,image/png

# --- Image validation (profile + face-enrollment photos) ---
IMAGE_MIN_DIMENSION=200
IMAGE_RECOMMENDED_MIN_DIMENSION=480
IMAGE_STORE_MAX_DIMENSION=1600
FACE_DETECTION_SCORE=0.7
FACE_BLUR_FAIL=8
FACE_BLUR_WARN=30
FACE_BRIGHTNESS_FAIL_LOW=35
FACE_BRIGHTNESS_WARN_LOW=70
FACE_BRIGHTNESS_WARN_HIGH=205
FACE_BRIGHTNESS_FAIL_HIGH=235
FACE_MAX_PHOTOS=5
ONBOARDING_TOKEN_EXPIRE_MINUTES=60

# --- Face recognition (Phase 6) ---
# Assists the teacher: pre-fills a DRAFT, never finalizes, never marks anyone absent.
FACE_RECOGNITION_ENABLED=true
# Model pack: buffalo_l (best, ~289 MB) | buffalo_s (~128 MB) | buffalo_sc (smallest, ~15 MB)
# Install first:  uv run python -m backend.app.scripts.download_face_models
FACE_RECOGNITION_MODEL=buffalo_l
# Used only if FACE_RECOGNITION_MODEL cannot be loaded ("" = no fallback); every recognition run
# records the model actually used and warns the teacher when the fallback was needed.
FACE_RECOGNITION_FALLBACK_MODEL=buffalo_sc
# Load the model in the background at startup (else the first run waits ~9 s for buffalo_l).
FACE_RECOGNITION_PRELOAD=true
# After a failed model load, refuse quickly for this many seconds before trying to load again.
FACE_RECOGNITION_RETRY_SECONDS=60
# A run still going after this many seconds is stopped between photos; attendance is not changed.
FACE_RECOGNITION_TIMEOUT_SECONDS=240
FACE_RECOGNITION_ALLOW_DOWNLOAD=false
FACE_RECOGNITION_DET_SIZE=1024
# FACE DETECTION (is it a face?) — separate from the FACE_MATCH_* identity thresholds below.
FACE_RECOGNITION_MIN_DET_SCORE=0.5
FACE_RECOGNITION_MIN_FACE_PX=20
# Group photos: native-resolution overlapping tiles for large photos (small/distant faces),
# automatic correction of sideways photos, and the IoU that merges duplicate boxes.
FACE_RECOGNITION_TILING=true
FACE_RECOGNITION_TILE_SIZE=1024
FACE_RECOGNITION_TILE_OVERLAP=0.25
FACE_RECOGNITION_AUTO_ORIENT=true
FACE_RECOGNITION_NMS_IOU=0.4
# Identity thresholds (cosine similarity). Calibrate with labelled images:
#   uv run python -m backend.app.scripts.benchmark_recognition <dataset>
#   uv run python -m backend.app.scripts.calibrate_recognition --probes <folder>
FACE_MATCH_CONFIDENT=0.50
FACE_MATCH_LOW=0.35
FACE_MATCH_AMBIGUITY_MARGIN=0.06
# Enrollment photos (≥3) that don't resemble the student's other photos are left out of matching.
FACE_ENROLLMENT_MIN_CONSISTENCY=0.2

# --- Attendance ---
# Low-attendance threshold (%) for student warnings, the student dashboard and teacher reports.
# (STUDENT_LOW_ATTENDANCE_THRESHOLD is accepted as a deprecated alias.)
LOW_ATTENDANCE_THRESHOLD=75
# Percentage policy (finalized sessions only). Late counts as attended × weight (0–1).
# Excused: exclude (not counted at all) | present | absent
ATTENDANCE_LATE_WEIGHT=1.0
ATTENDANCE_EXCUSED_POLICY=exclude
ATTENDANCE_MAX_SESSIONS_PER_DAY=8
ATTENDANCE_MAX_BACKDATE_DAYS=14
# Hours after finalizing during which the teacher may still correct or delete it (with a reason).
# 0 = locked as soon as it is finalized (nobody else can correct attendance).
ATTENDANCE_TEACHER_CORRECTION_HOURS=24
ATTENDANCE_MAX_PHOTOS=5
ATTENDANCE_PHOTO_MIN_DIMENSION=480
ATTENDANCE_PHOTO_MAX_DIMENSION=2560
# Long side ÷ short side above this is refused (not a classroom photo). Phone panoramas are ~3–5.
ATTENDANCE_PHOTO_MAX_ASPECT_RATIO=6
# IANA timezone for "today" (e.g. Asia/Karachi). Empty = server local time.
APP_TIMEZONE=Asia/Karachi

# --- Initial super admin (created by init_db; change the password after first login) ---
SUPERADMIN_EMAIL=admin@smartclass.edu
SUPERADMIN_PASSWORD=ChangeMe@123
SUPERADMIN_NAME=System Administrator
